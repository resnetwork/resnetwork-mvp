// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// NEXTAUTH MODELS (Обязательные для интеграции авторизации)
// -----------------------------------------------------------------------------

model Account {
  id                 String  @id @default(cuid())
  userId             String  @map("user_id")
  type               String
  provider           String
  providerAccountId  String  @map("provider_account_id")
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// -----------------------------------------------------------------------------
// DOMAIN MODELS (Связи платформы RES 365)
// -----------------------------------------------------------------------------

model Company {
  id          String   @id @default(cuid())
  name        String
  bin         String   @unique // БИН компании
  description String?
  logoUrl     String?  @map("logo_url")
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users       User[]
  events      Event[]

  @@map("companies")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  
  // Дополнительные поля для платформы
  role          String    @default("EMPLOYEE") // SYSTEM_ADMIN, COMPANY_ADMIN, EMPLOYEE
  companyId     String?   @map("company_id")
  company       Company?  @relation(fields: [companyId], references: [id])
  
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  accounts      Account[]
  sessions      Session[]
  tickets       Ticket[]

  @@map("users")
}

model Event {
  id               String   @id @default(cuid())
  title            String
  description      String?
  date             DateTime
  location         String?
  imageUrl         String?  @map("image_url")
  isPublic         Boolean  @default(false) @map("is_public")
  
  creatorCompanyId String   @map("creator_company_id")
  creatorCompany   Company  @relation(fields: [creatorCompanyId], references: [id])
  
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tickets          Ticket[]

  @@map("events")
}

model Ticket {
  id        String   @id @default(cuid()) // Этот ID будет хэшироваться в QR-код
  status    String   @default("VALID") // VALID, USED, CANCELLED
  
  eventId   String   @map("event_id")
  event     Event    @relation(fields: [eventId], references: [id])
  
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([eventId, userId]) // Один пользователь может получить только один билет на конкретный ивент
  @@map("tickets")
}

model ContactRequest {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  company   String?
  message   String
  status    String   @default("NEW") // NEW, PROCESSED
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("contact_requests")
}
